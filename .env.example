# Copy this file to .env and replace the placeholder with your Gemini API key.
GOOGLE_API_KEY=your-google-api-key-here
PRIMARY_CHAT_MODEL=gemini-3.5-flash
FALLBACK_CHAT_MODEL=gemini-3.1-flash-lite
RAG_API_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=90
REQUEST_DEADLINE_SECONDS=90
MAX_PLANNER_CONCURRENCY=2
MAX_EMBEDDING_CONCURRENCY=4
MAX_GENERATION_CONCURRENCY=2
MAX_PENDING_REQUESTS=12
QUEUE_TIMEOUT_SECONDS=10
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
CIRCUIT_HALF_OPEN_MAX_CALLS=1
RETRY_AFTER_SECONDS=5
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=90
